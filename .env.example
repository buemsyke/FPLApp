# =============================================================================
# GutachtenAbiturklausur – Konfigurationsdatei (.env)
# =============================================================================
# Kopiere diese Datei zu .env und fülle die Werte aus.
# In der Oberfläche lassen sich Provider und Modell zusätzlich in der
# Seitenleiste umschalten – die Werte hier sind nur die Vorbelegung.
# =============================================================================

# KI-Provider: lokal | ollama | bonsai | hetzner | gwdg
# - lokal:   LM Studio auf diesem Rechner (http://localhost:1234)
# - ollama:  Ollama auf diesem Rechner (http://localhost:11434)
# - bonsai:  Bonsai-Laufzeit auf diesem Rechner (Adresse siehe BONSAI_BASE_URL)
# - hetzner / gwdg: Cloud – für Klausurentwürfe NICHT verwenden
KI_PROVIDER=lokal

# Modell (ID oder Teilstring, leer = automatisch nach Präferenzliste).
# Beispiele: gemma-4-12b (LM Studio), gemma4:12b (Ollama), bonsai (Bonsai)
KI_MODELL=

# Optional: Kontextfenster erzwingen, falls der Server es nicht meldet
# (sonst Annahme 8192 Token → Texte werden stärker gekürzt).
# KI_KONTEXT=32768

# Optional: Denkphase per Prefill überspringen (auto | ja | nein).
# "auto" erkennt Qwen3/Ministral/Magistral. Für Bonsai auf Qwen-Basis ggf. "ja".
# KI_DENKPHASE_UEBERSPRINGEN=auto

# Optional: Timeout pro Aufruf in Sekunden (Apple Silicon Standard: 600)
# KI_TIMEOUT=600

# =============================================================================
# Lokaler LM Studio Server (KI_PROVIDER=lokal)
# =============================================================================
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT=1800
LMSTUDIO_VISION_MODELL=

# =============================================================================
# Ollama (KI_PROVIDER=ollama)
# =============================================================================
# Wichtig: Ollama nutzt sonst ein kleines Kontextfenster und schneidet lange
# Klausuren stillschweigend ab. Starten mit:
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Bonsai-Laufzeit (KI_PROVIDER=bonsai)
# =============================================================================
# Adresse des OpenAI-kompatiblen Servers der Bonsai-Laufzeit (ohne /v1).
# Port nach dem Start der Laufzeit prüfen und hier eintragen.
BONSAI_BASE_URL=http://localhost:8080

# =============================================================================
# Hetzner Cloud (KI_PROVIDER=hetzner)
# =============================================================================
# API-Key abholen unter: https://console.hetzner.cloud/
HETZNER_AI_API_KEY=

# =============================================================================
# GWDG Universität Göttingen (KI_PROVIDER=gwdg)
# =============================================================================
# API-Key anfordern unter: https://chat.gwdg.de/
GWDG_API_KEY=

# =============================================================================
# Optional: Erweiterte Einstellungen
# =============================================================================
# Datei-Upload-Größe (in MB, standard: 200)
# STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200

# Timeout für lange Prozesse (in Sekunden)
# PROCESS_TIMEOUT=3600
